# Public browser configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_BASE_SEPOLIA_TREASURY_OPERATOR_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_FACTORY=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASE_TREASURY_OPERATOR_ADDRESS=
NEXT_PUBLIC_BASE_FACTORY=
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_REGISTRY=
NEXT_PUBLIC_TREASURY_OPERATOR_ADDRESS=
NEXT_PUBLIC_ONE_SHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
AGENT_SIGNER_PRIVATE_KEY=
OWNER_SESSION_SECRET=
AGENT_API_KEY_SECRET=
CRON_SECRET=
GENLAYER_REGISTRY=
ONE_SHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers

# Optional standalone relay worker. The worker only triggers the authenticated
# Vercel cron endpoint; it never accepts payout payloads.
WEB_APP_URL=
PORT=8787

# Testnet pilot operations. MONGODB_URI enables durable request projections,
# lifecycle events, rate limit windows, and tester feedback. Without it the
# pilot store degrades to disabled and public spend rate limiting is skipped.
# The Atlas Network Access list must allow the deployment platform's egress
# IPs; Vercel is dynamic, so the pilot uses an open allowlist entry.
MONGODB_URI=
MONGODB_DB=treasury_copilot
ADMIN_WALLET_ALLOWLIST=

# Arc Testnet settlement (chain 5042002).
# Arc has no MetaMask Delegation Framework and no 1Shot relayer support, so approved Arc
# payments settle through an AgentTreasury vault called by a dedicated executor instead of an
# ERC-7715 delegation. See docs/arc.md for the verified network constants.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_USDC=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_TESTNET_VAULT_FACTORY=
NEXT_PUBLIC_ARC_TESTNET_EXECUTOR_ADDRESS=
ARC_SETTLEMENT_ENABLED=false

# Server-only. Must be a different key from AGENT_SIGNER_PRIVATE_KEY so the Arc executor is not
# also the registry gateway or the GenLayer reporter. Funded with Arc USDC, which is the gas
# token. Never prefix with NEXT_PUBLIC_.
ARC_EXECUTOR_PRIVATE_KEY=

# Chains the agent API will accept. Add 5042002 to enable Arc Testnet.
ALLOWED_EVM_CHAIN_IDS=84532,5042002
