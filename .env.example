NEXT_PUBLIC_ONE_SHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
AGENT_SIGNER_PRIVATE_KEY=
OWNER_SESSION_SECRET=
AGENT_API_KEY_SECRET=
CRON_SECRET=
GENLAYER_REGISTRY=
ONE_SHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers

# Optional standalone relay worker. The worker only triggers the authenticated
# Vercel cron endpoint; it never accepts payout payloads.
WEB_APP_URL=
PORT=8787

# Testnet pilot operations. MONGODB_URI enables durable request projections,
# lifecycle events, rate limit windows, and tester feedback. Without it the
# pilot store degrades to disabled and public spend rate limiting is skipped.
# The Atlas Network Access list must allow the deployment platform's egress
# IPs; Vercel is dynamic, so the pilot uses an open allowlist entry.
MONGODB_URI=
MONGODB_DB=treasury_copilot
ADMIN_WALLET_ALLOWLIST=
